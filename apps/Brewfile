# Brewfile for a new Mac: the basics + the hand-picked apps (installed by default by
# the setup script, https://setup.hassanpi.com/mac.sh).
# Install by hand: brew bundle --file=apps/Brewfile  (from `chezmoi cd`)
# Everything else from the old Mac is in apps/Brewfile.full (mac.sh --all-apps).

# --- Basics: dotfiles tools, prompt font, GitHub login helper, password manager ---
brew "chezmoi"
brew "starship"
cask "font-jetbrains-mono-nerd-font"
cask "git-credential-manager"
cask "bitwarden"

# --- Apps (picked 2026-11-17) ---
cask "google-chrome"
cask "claude"
cask "discord"
cask "visual-studio-code"
cask "ghostty"
cask "obs"
